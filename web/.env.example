# Base URL of the Upkeep agent status API (GET /api/status, GET /api/quote).
NEXT_PUBLIC_AGENT_URL=http://localhost:8787
# Base JSON-RPC used for balances, allowances, simulation and fill logs.
NEXT_PUBLIC_BASE_RPC_URL=https://base-rpc.publicnode.com
# Blocks of Swapped events to scan for the ledger, bounded to 100000.
NEXT_PUBLIC_FILL_LOOKBACK_BLOCKS=30000
# Optional: block the strategy was shipped in, so fill scans start there.
NEXT_PUBLIC_FILL_FROM_BLOCK=
# Local fork only, set by scripts/dev-fork.sh. A localhost RPC switches the wallet to the fork's unlocked test account.
NEXT_PUBLIC_RPC_URL=
NEXT_PUBLIC_DEV_ACCOUNT=
